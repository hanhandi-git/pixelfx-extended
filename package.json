{
  "name": "pixelfx",
  "version": "0.4.0",
  "description": "Code-driven pixel art effects, fantasy maps, minions, bosses and encounters, and a Claude Code skill to make your own.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./fx/*": "./src/fx/*.js",
    "./core/*": "./src/core/*.js",
    "./encounters/*": "./src/encounters/*.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "render": "node tools/render.mjs",
    "check": "node tools/check.mjs",
    "gallery": "node tools/serve.mjs",
    "build:web": "node tools/build-gallery.mjs",
    "cocos": "node tools/cocos.mjs",
    "cocos:export": "node tools/cocos.mjs --out ../pixelfx-cocos/assets/resources/pixelfx",
    "map": "node tools/map.mjs",
    "encounter": "node tools/encounter.mjs",
    "montage:new": "node tools/montage.mjs docs/readme/montage-new.gif --category world --cols 3 --rows 2 --cell 320x180 --seconds 6 --scale 1",
    "font:han": "python3 tools/gen-han-glyphs.py"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "ffmpeg-static": "^5.3.0"
  }
}
